<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>YoloSharpOnnx</Title>
		<PackageProjectUrl>https://github.com/meloht/YoloSharpOnnx</PackageProjectUrl>
		<RepositoryUrl>https://github.com/meloht/YoloSharpOnnx</RepositoryUrl>
		<PackageTags>yolov8;yolov11;yolov26;yolo8;yolo11;yolo26;yolo;object-detection;image-classification;opencv;csharp;onnx;onnx-runtime;cross-platform;cpu;cuda;gpu;tensorrt;coreml;directml;computer-vision</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>YoloSharpOnnx is a high performance, memory reuse, cross-platform, production-ready C# YOLO inference library for object detection base on OpenCV and ONNX Runtime.</Description>
		<Authors>meloht</Authors>
		<Version>2.0.0</Version>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright © meloht</Copyright>
		<PackageReleaseNotes>YoloSharpOnnx 2.0.0 Yolo task classify api and remove BatchDetectItemCompleted api</PackageReleaseNotes>
		<PackageIcon>YoloSharpOnnx.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\imgs\YoloSharpOnnx.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\README.md" Link="README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.25.1" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260427" />
	</ItemGroup>

</Project>
